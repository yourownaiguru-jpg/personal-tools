,"#2A2A2E"]},{"kanji":"雪下","name":"Yuki-no-shita","season":"Winter · under snow","desc":"White over red plum","c":["#FFFFFB","#E8E6E1","#C6496A","#7A1F3A"]},{"kanji":"氷襲","name":"Kōri-gasane","season":"Winter · ice","desc":"Glossy white over white","c":["#FFFFFB","#E4EBEE","#B7C9D1","#8297A2"]}],"harmonies":[{"name":"Monochromatic","desc":"One hue in many values and chromas. Calm and unified; trains value control.","c":["#1E2F4F","#2E4A7A","#5674A8","#93A9CF","#D3DDEE"]},{"name":"Analogous","desc":"3–4 neighbours on the wheel. Harmonious and natural: sunsets, foliage, the sea.","c":["#7A2E1F","#C2502A","#E58B3A","#F2C35B","#F7E3A8"]},{"name":"Complementary","desc":"Opposites — blue/orange, red/green, violet/yellow. Maximum vibrance; let one dominate.","c":["#233A73","#4E6AA8","#EDE6D8","#E8945A","#C4581E"]},{"name":"Split-complementary","desc":"A hue plus the two neighbours of its complement. Contrast with less tension.","c":["#B32A2A","#E9D9C4","#2F7F6F","#3E6E9E","#1D2B33"]},{"name":"Triadic","desc":"Three hues evenly spaced. Lively and balanced; mute two and keep one pure.","c":["#C8A43A","#9B3B3B","#33507A","#E8DFCC","#2A2522"]},{"name":"Tetradic","desc":"Two complementary pairs. Very rich — choose one dominant and grey the rest.","c":["#3E6B48","#B4475A","#D9A441","#4B4E8A","#EFE7DA"]},{"name":"Neutral + accent","desc":"Greys, earths and whites with one saturated spot.","c":["#3A3631","#7D746A","#BEB5A8","#E9E3D8","#D2452B"]}],"limited":[{"name":"Zorn","desc":"Anders Zorn (1860–1920). Ochre, red, black and white — black acts as a cool blue. Famous for portraits and skin tones.","c":["#C9962F","#E0382A","#232323","#F4F4F0"],"labels":["Yellow Ochre","Cadmium Red Light","Ivory Black","Titanium White"]},{"name":"Split-primary","desc":"A warm and a cool version of each primary. Mixes almost any clean colour.","c":["#F2E21B","#FDBE12","#E0382A","#A3245E","#2B3990","#123C7A","#F4F4F0"],"labels":["Lemon Yellow","Cad. Yellow Med.","Cad. Red Light","Quin. Magenta","Ultramarine","Phthalo Blue","Titanium White"]},{"name":"Earth","desc":"Old Masters' earths. Warm, unified and forgiving; add Ultramarine for cool shadows.","c":["#C9962F","#B0702E","#8E401F","#4C2E1F","#5C4C38","#2B3990","#F4F4F0"],"labels":["Yellow Ochre","Raw Sienna","Burnt Sienna","Burnt Umber","Raw Umber","Ultramarine","Titanium White"]},{"name":"Monet-style","desc":"Close to the pigments Monet listed late in life. No black.","c":["#F4F4F0","#FDBE12","#E0442A","#8E1D33","#1F55A8","#2E7D63"],"labels":["Titanium White","Cadmium Yellow","Vermilion Hue","Alizarin Hue","Cobalt Blue Hue","Viridian Hue"]},{"name":"Ukiyo-e","desc":"Prussian blue beside soft vermilion, yellow and paper tones, after Hokusai and Hiroshige.","c":["#1C3B57","#2A4560","#E0442A","#C9962F","#E8DCC4","#1E1E1E"],"labels":["Prussian Blue","Indigo","Vermilion Hue","Yellow Ochre","Unbleached Titanium","Mars Black"]}],"seasons":[{"name":"Spring","desc":"Light, clear and youthful: pale yellows, yellow-greens, soft pinks and lilacs. High value, low contrast.","c":["#F7E98E","#C9E07A","#9CCB86","#F6C1C7","#D9C6E8","#FFF7DC"]},{"name":"Summer","desc":"Full, saturated and cooler: strong blues, blue-greens, rose and violet with luminous lights.","c":["#2C6FB7","#3BA3A0","#7DC383","#D4567A","#8A5BA8","#F3E9A0"]},{"name":"Autumn","desc":"Warm, deep and broken: ochres, rust, olive, maroon and brown.","c":["#C9962F","#B5502A","#7A6A2A","#6E2A2E","#4C2E1F","#D9B57A"]},{"name":"Winter","desc":"Cold, still and high-contrast: icy whites, blue-greys, deep navy and black, with a little crimson.","c":["#F4F6F8","#B8C6D3","#5F7487","#1C2B44","#141414","#8E1D33"]}]}